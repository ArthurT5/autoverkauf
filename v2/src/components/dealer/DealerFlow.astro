---
import { getLangFromUrl, useTranslations } from "@/lib/i18n/utils";
const t = useTranslations(getLangFromUrl(Astro.url));
const steps = [
  { t: t("dp.flow.s1t"), b: t("dp.flow.s1b") },
  { t: t("dp.flow.s2t"), b: t("dp.flow.s2b") },
  { t: t("dp.flow.s3t"), b: t("dp.flow.s3b") },
];
---

<section data-nav="dark" class="grain-dark relative isolate overflow-hidden bg-void py-28 text-white lg:py-40">
  <div aria-hidden class="pointer-events-none absolute right-[-6%] top-[20%] h-[440px] w-[600px] max-w-[60vw] rounded-full opacity-[0.09] blur-[150px]" style="background: var(--color-red)"></div>
  <div class="relative z-10 mx-auto w-full max-w-[82rem] px-[var(--gutter)]">
    <div class="max-w-[40rem]">
      <span data-reveal="up" class="text-[11px] font-medium uppercase tracking-[0.18em] text-white/50 [font-family:var(--font-mono)]">
        <span style="color: var(--color-red)">//</span> {t("dp.flow.kicker")}
      </span>
      <h2 data-reveal="h" class="mt-5 text-[clamp(2rem,3.6vw,3.1rem)] font-medium leading-[1.04] tracking-[-0.025em] [font-family:var(--font-display)]">
        {t("dp.flow.title")}
      </h2>
    </div>

    <ol class="mt-16 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:mt-24 lg:grid-cols-3">
      {steps.map((s, i) => (
        <li data-reveal="up">
          <div class="flex items-center justify-between border-t border-white/[0.14] pt-5">
            <span class="text-[13px] [font-family:var(--font-mono)]" style="color: var(--color-red)">0{i + 1}</span>
            {i < steps.length - 1 && (
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none" class="text-white/25"><path d="M3 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </div>
          <h3 class="mt-6 text-[1.3rem] font-semibold tracking-[-0.015em] text-white">{s.t}</h3>
          <p class="mt-3 max-w-[24rem] text-[0.975rem] leading-[1.6] text-white/55">{s.b}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
