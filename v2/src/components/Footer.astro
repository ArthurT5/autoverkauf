---
import { getLangFromUrl, useTranslations, localizedPath, localeList } from "@/lib/i18n/utils";
import { languages } from "@/lib/i18n/ui";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const cols = [
  { title: t("footer.product"), links: [
    { label: t("nav.how"), href: "/#how-it-works" },
    { label: t("nav.dealers"), href: "/haendler" },
    { label: t("nav.pricing"), href: "/haendler#pricing" },
  ]},
  { title: t("footer.company"), links: [
    { label: t("footer.about"), href: "/ueber-uns" },
    { label: t("footer.contact"), href: "/kontakt" },
  ]},
  { title: t("footer.legal"), links: [
    { label: t("footer.privacy"), href: "/datenschutz" },
    { label: t("footer.terms"), href: "/agb" },
  ]},
];
---

<footer data-nav="dark" class="grain-dark relative isolate overflow-hidden bg-void px-[var(--gutter)] pb-10 pt-20 text-white lg:pt-28">
  <div class="mx-auto w-full max-w-[82rem]">
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 border-b border-white/10 pb-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="col-span-2 md:col-span-1">
        <a href={localizedPath("/", lang)} class="inline-flex items-center" aria-label="AutoVerkauf">
          <img src="/brand/lockup-on-dark.svg" alt="AutoVerkauf" width="146" height="32" class="h-8 w-auto" />
        </a>
        <p class="mt-4 max-w-[22rem] text-[0.9rem] leading-[1.6] text-white/45">{t("footer.tagline")}</p>
      </div>
      {cols.map((c) => (
        <nav class="flex flex-col">
          <p class="text-[10px] uppercase tracking-[0.16em] text-white/35 [font-family:var(--font-mono)]">{c.title}</p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {c.links.map((l) => (
              <li><a href={localizedPath(l.href, lang)} class="text-[0.9rem] text-white/60 transition-colors hover:text-white">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="flex flex-col items-start justify-between gap-4 pt-7 sm:flex-row sm:items-center">
      <p class="text-[0.8rem] text-white/40">© {year} AutoVerkauf — {t("footer.rights")}</p>
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-1 text-[0.75rem]">
          {localeList.map((l, i) => (
            <>
              {i > 0 && <span class="text-white/20">/</span>}
              <a href={l === lang ? "#" : localizedPath("/", l)} class:list={["num uppercase tracking-[0.06em] transition-colors", l === lang ? "text-white" : "text-white/40 hover:text-white/70"]} title={languages[l]}>{l}</a>
            </>
          ))}
        </div>
        <span class="text-[0.8rem] text-white/40">· {t("footer.made")}</span>
      </div>
    </div>
  </div>
</footer>
