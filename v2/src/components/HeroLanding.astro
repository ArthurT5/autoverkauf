---
import HeroCalm from "./HeroCalm.tsx";
import { buildHeroDict } from "@/lib/heroDict";
import { getLangFromUrl, localizedPath } from "@/lib/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const dict = buildHeroDict(lang);
---

<HeroCalm client:load dict={dict} theme="light" ctaHref={localizedPath("/anfrage", lang)} dealerHref={localizedPath("/haendler", lang)} />
