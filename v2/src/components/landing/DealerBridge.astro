---
import { getLangFromUrl, useTranslations, localizedPath } from "@/lib/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section data-nav="dark" class="grain-dark relative isolate overflow-hidden bg-void py-20 text-white lg:py-24">
  <div aria-hidden class="pointer-events-none absolute left-1/2 top-1/2 h-[340px] w-[560px] max-w-[70vw] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-[0.08] blur-[140px]" style="background: var(--color-red)"></div>
  <div class="relative z-10 mx-auto flex w-full max-w-[82rem] flex-col items-start justify-between gap-8 px-[var(--gutter)] md:flex-row md:items-center">
    <div data-reveal="up" class="max-w-[40rem]">
      <span class="text-[11px] font-medium uppercase tracking-[0.18em] text-white/45 [font-family:var(--font-mono)]">
        <span style="color: var(--color-red)">//</span> {t("dealers.kicker")}
      </span>
      <h2 class="mt-3 text-[clamp(1.7rem,3vw,2.4rem)] font-medium leading-[1.08] tracking-[-0.02em] [font-family:var(--font-display)]">
        {t("bridge.title")}
      </h2>
      <p class="mt-2.5 max-w-[34rem] text-[0.975rem] leading-[1.6] text-white/55">{t("bridge.lead")}</p>
    </div>
    <a
      data-reveal="up"
      href={localizedPath("/haendler", lang)}
      class="group inline-flex shrink-0 items-center justify-center gap-2.5 rounded-[var(--radius-md)] border border-white/20 px-6 py-3.5 text-[0.95rem] font-medium text-white transition-colors duration-200 hover:border-white/45"
    >
      {t("bridge.cta")}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="transition-transform duration-200 group-hover:translate-x-0.5"><path d="M3 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>
</section>
