---
// The dedicated dealer (B2B) page — Radar hero (dark) + theme-switching
// sections + contour "reach" blend + drenched-red CTA + footer.
import Reveal from "@/components/motion/Reveal.tsx";
import DealerHeroRadar, { type DealerHeroDict } from "@/components/dealer/DealerHeroRadar.tsx";
import DealerProblem from "@/components/dealer/DealerProblem.astro";
import DealerFlow from "@/components/dealer/DealerFlow.astro";
import DealerReach from "@/components/dealer/DealerReach.astro";
import DealerPricing from "@/components/dealer/DealerPricing.astro";
import DealerFAQ from "@/components/dealer/DealerFAQ.astro";
import DealerCTA from "@/components/dealer/DealerCTA.astro";
import Footer from "@/components/Footer.astro";
import { getLangFromUrl, useTranslations } from "@/lib/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const hero: DealerHeroDict = {
  kicker: t("dealers.kicker"),
  tagline: t("dealers.tagline"),
  title: t("dealers.title"),
  sub: t("dealers.hsub"),
  cta: t("dealers.cta"),
  scroll: t("dealers.scroll"),
};
---

<DealerHeroRadar client:load dict={hero} />
<DealerProblem />
<DealerFlow />
<DealerReach />
<DealerPricing />
<DealerFAQ />
<DealerCTA />
<Footer />
<Reveal client:load />
