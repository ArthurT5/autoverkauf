---
// Dealer page · Direction B — "Contour" (light)
import Base from "@/layouts/Base.astro";
import DealerHeroContour from "@/components/dealer/DealerHeroContour.tsx";
import type { DealerHeroDict } from "@/components/dealer/DealerHeroRadar.tsx";
import { getLangFromUrl, useTranslations } from "@/lib/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const dict: DealerHeroDict = {
  kicker: t("dealers.kicker"),
  tagline: t("dealers.tagline"),
  title: t("dealers.title"),
  sub: t("dealers.hsub"),
  cta: t("dealers.cta"),
  scroll: t("dealers.scroll"),
};
---

<Base navTheme="light">
  <DealerHeroContour client:load dict={dict} />
</Base>
