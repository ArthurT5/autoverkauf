---
import Base from "@/layouts/Base.astro";
import HeroEditorial from "@/components/HeroEditorial.tsx";
import { buildHeroDict } from "@/lib/heroDict";
import { getLangFromUrl } from "@/lib/i18n/utils";

const dict = buildHeroDict(getLangFromUrl(Astro.url));
---

<Base navTheme="dark">
  <HeroEditorial client:load dict={dict} />
</Base>
