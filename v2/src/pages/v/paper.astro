---
import Base from "@/layouts/Base.astro";
import HeroPaper from "@/components/HeroPaper.tsx";
import { buildHeroDict } from "@/lib/heroDict";
import { getLangFromUrl } from "@/lib/i18n/utils";

const dict = buildHeroDict(getLangFromUrl(Astro.url));
---

<Base navTheme="light">
  <HeroPaper client:load dict={dict} />
</Base>
