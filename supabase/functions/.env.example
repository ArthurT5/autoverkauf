# Secrets for the billing Edge Functions.
# Set for real with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# Stripe — TEST keys until go-live. API version is pinned in code (2026-05-27,
# required for TWINT recurring — spec §10).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription price IDs (created by scripts/stripe-setup.mjs)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# HMAC secret for buyer accept-offer email links (any long random string)
ACCEPT_TOKEN_SECRET=

# Shared secret for internal endpoints (onboard-garage, process-stripe-jobs)
ADMIN_API_KEY=

# Used for Checkout success/cancel redirect URLs
PUBLIC_SITE_URL=http://localhost:4321
